services:
  rest-server:
    container_name: rest-server
    image: restic/rest-server:0.15.0@sha256:5922067eb6f1ed8a632bc56101677ab4968a3b88a28806423e95ebb5eeecdebb
    environment:
      PASSWORD_FILE: /config/htpasswd
      OPTIONS: --private-repos --append-only
    volumes:
      - /srv/rest-server/config:/config:ro
      - /srv/rest-server/data:/data
    ports:
      - "{{ rest_server_port }}:8000"
    restart: unless-stopped
