services:
  homeassistant:
    container_name: homeassistant
    image: ghcr.io/home-assistant/home-assistant:2026.11.2@sha256:493a07e8f6530fc640223f4a0a5248f20a61ca2f718bb1d31efbf08a2c5ea28f
    # Host network so it can discover devices in the local network and receive
    # their status updates.
    network_mode: host
    volumes:
      # Home Assistant writes its backups to /config/backups.
      - /srv/homeassistant/config:/config
      - /etc/localtime:/etc/localtime:ro
    restart: unless-stopped
