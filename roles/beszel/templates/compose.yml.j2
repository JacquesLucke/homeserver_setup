services:
  beszel:
    container_name: beszel
    image: henrygd/beszel:0.21.1@sha256:8514a69d9bbbcb74f371a3205561ee231fc0289739cea64e8131f341d695b770
    environment:
      APP_URL: http://{{ ansible_facts.hostname }}:{{ beszel_port }}
    ports:
      - "{{ beszel_port }}:8090"
    volumes:
      - /srv/beszel/data:/beszel_data
      - /srv/beszel/socket:/beszel_socket
    restart: unless-stopped
{% if vault_beszel_agent_key is defined %}
{% set smart_disks = mounted_disks + [disk_system] %}

  # Collects the server's stats and sends them to the hub over the socket.
  beszel-agent:
    container_name: beszel-agent
    # Intel variant includes intel_gpu_top for GPU utilisation (i915 driver).
    image: henrygd/beszel-agent-intel:0.21.1@sha256:a8c8ee4eb71b66132128fb5421b6c27491d2b652a7aabcfdc638b60aaf529703
    # Host network so it sees the server's real network traffic.
    network_mode: host
    # intel_gpu_top reads the GPU's performance counters.
    cap_add:
      - CAP_PERFMON
      # Reading S.M.A.R.T. data needs raw disk access.
      - SYS_RAWIO
    # Docker's AppArmor profile doesn't allow talking to systemd over D-Bus.
    security_opt:
      - apparmor:unconfined
    devices:
      - /dev/dri/card0:/dev/dri/card0
{% for disk in smart_disks %}
      - /dev/disk/by-id/{{ disk.disk_id }}:/dev/{{ disk.name }}
{% endfor %}
    environment:
      LISTEN: /beszel_socket/beszel.sock
      HUB_URL: http://localhost:{{ beszel_port }}
      KEY: "{{ vault_beszel_agent_key }}"
      TOKEN: "{{ vault_beszel_agent_token }}"
      # The disks have custom names in the container, so smartctl doesn't find
      # them on its own.
      SMART_DEVICES: "{{ smart_disks | map(attribute='name') | map('regex_replace', '^', '/dev/') | map('regex_replace', '$', ':sat') | join(',') }}"
    volumes:
      - /srv/beszel/agent:/var/lib/beszel-agent
      - /srv/beszel/socket:/beszel_socket
      - /var/run/docker.sock:/var/run/docker.sock:ro
      # Lets the agent read the state of the systemd services.
      - /var/run/dbus/system_bus_socket:/var/run/dbus/system_bus_socket:ro
{% for disk in mounted_disks %}
{% set device = (ansible_facts.mounts | selectattr('mount', 'equalto', '/mnt/' ~ disk.name) | first).device | basename %}
      - /mnt/{{ disk.name }}/.beszel:/extra-filesystems/{{ device }}__{{ disk.name }}:ro
{% endfor %}
    restart: unless-stopped
{% endif %}
