services:
  beszel:
    image: henrygd/beszel:latest
    environment:
      APP_URL: http://{{ ansible_facts.hostname }}:8090
    ports:
      - 8090:8090
    volumes:
      - /srv/beszel/data:/beszel_data
      - /srv/beszel/socket:/beszel_socket
    restart: unless-stopped
{% if vault_beszel_agent_key is defined %}

  # Collects the server's stats and sends them to the hub over the socket.
  beszel-agent:
    image: henrygd/beszel-agent:latest
    # Host network so it sees the server's real network traffic.
    network_mode: host
    environment:
      LISTEN: /beszel_socket/beszel.sock
      HUB_URL: http://localhost:8090
      KEY: "{{ vault_beszel_agent_key }}"
      TOKEN: "{{ vault_beszel_agent_token }}"
    volumes:
      - /srv/beszel/agent:/var/lib/beszel-agent
      - /srv/beszel/socket:/beszel_socket
      - /var/run/docker.sock:/var/run/docker.sock:ro
{% for disk in storage_disks %}
{% set device = (ansible_facts.mounts | selectattr('mount', 'equalto', '/mnt/' ~ disk.name) | first).device | basename %}
      - /mnt/{{ disk.name }}/.beszel:/extra-filesystems/{{ device }}__{{ disk.name }}:ro
{% endfor %}
    restart: unless-stopped
{% endif %}
