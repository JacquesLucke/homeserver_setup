network:
  version: 2
  ethernets:
    # This ethernet port is waited for during boot up to a timeout.
    # The other ports are used as fallbacks.
    enp1s0:
      dhcp4: true
      accept-ra: true
    enp2s0:
      dhcp4: true
      accept-ra: true
      optional: true
  wifis:
    wlo1:
      dhcp4: true
      accept-ra: true
      optional: true
      access-points:
        {{ vault_wifi_ssid | to_json }}:
          password: {{ vault_wifi_password | to_json }}
