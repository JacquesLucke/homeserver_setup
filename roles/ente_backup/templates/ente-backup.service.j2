[Unit]
Description=Export Ente Photos to the storage pool
Wants=network-online.target
After=network-online.target
RequiresMountsFor={{ ente_export_dir }}

[Service]
Type=oneshot
User=ente
Group=ente
ExecStart=/usr/local/bin/ente-cli-wrapper photos export {{ ente_export_dir }} --account personal --exclude-hidden --no-input
