[global]
  # This is where copyparty stores extra data like thumbnails.
  hist: /hist

  # Require user name and password to log in, not just the password.
  usernames

  # Store hashed passwords with a fixed salt when the machine is refreshed.
  ah-alg: argon2
  ah-salt: ghPDJ4PBRfKdG3bA2AgQ3z8vb

  # Enable a data-base to remember uploads.
  e2d
  # Unposting can only be done for the given duration in seconds.
  unpost: 604800  # = 1 week
  # Ownership is checked by account, not IP address.
  unp-who: 3

# The account names are in the vault, so they aren't public.
[accounts]
{% for account in vault_copyparty_media_accounts %}
  {{ account.name }}: {{ account.password_hash }}
{% endfor %}

[/]
  /media
  accs:
    # "A" means all permissions.
    A: {{ vault_copyparty_media_accounts | map(attribute='name') | join(', ') }}
