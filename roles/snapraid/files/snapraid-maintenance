#!/bin/bash
# Syncs the parity and checks part of the data for silent corruption.
set -euo pipefail

# Syncing after an accidental mass deletion or ransomware would make the
# deleted files unrecoverable, so stop and let me check first.
max_removed=50

# diff exits with 2 if there are changes to sync.
diff_status=0
diff_output=$(snapraid diff 2>&1) || diff_status=$?
if [ "$diff_status" -ne 0 ] && [ "$diff_status" -ne 2 ]; then
    echo "$diff_output"
    exit "$diff_status"
fi

removed=$(awk '$2 == "removed" { print $1 }' <<< "$diff_output")
if [ "${removed:-0}" -gt "$max_removed" ]; then
    echo "$removed files were removed, more than $max_removed. Not syncing." >&2
    echo "Check with 'snapraid diff' and run 'snapraid sync' manually if intended." >&2
    exit 1
fi

snapraid sync
# Check the 5% of the data that wasn't checked for the longest time, if it
# wasn't checked in the last 10 days.
snapraid scrub -p 5 -o 10
