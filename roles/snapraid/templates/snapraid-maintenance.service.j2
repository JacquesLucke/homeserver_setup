[Unit]
Description=Sync and scrub the SnapRAID parity
# Require all data and parity disks to be available.
RequiresMountsFor={{ (snapraid_data_disks + snapraid_parity_disks) | map(attribute='name') | map('regex_replace', '^', '/mnt/') | join(' ') }}
OnFailure=notify-failure@%n.service

[Service]
Type=oneshot
ExecStart=/usr/local/bin/snapraid-maintenance
Nice=19
IOSchedulingClass=idle
