services:
  jellyfin:
    container_name: jellyfin
    image: jellyfin/jellyfin:12.4@sha256:fea863d0cd9ec445985d9c75fc6ed64e38a1d2766cf0c250a33d553f4fc1b771
    user: "{{ ansible_facts.getent_passwd.jacques[1] }}:{{ ansible_facts.getent_passwd.jacques[2] }}"
    volumes:
      - /srv/jellyfin/config:/config
      - /srv/jellyfin/cache:/cache
      - /mnt/storage/media:/media
      # Jellyfin always writes its backups to this folder.
      - /mnt/storage/app_backup/jellyfin:/config/data/backups
    # Intel Quick Sync hardware transcoding
    devices:
      - /dev/dri/renderD128:/dev/dri/renderD128
    group_add:
      - "{{ ansible_facts.getent_group.render[1] }}"
    ports:
      - "{{ jellyfin_port }}:8096"
    restart: unless-stopped
