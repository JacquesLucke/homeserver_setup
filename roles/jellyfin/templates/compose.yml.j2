services:
  jellyfin:
    container_name: jellyfin
    image: jellyfin/jellyfin:latest
    user: "{{ ansible_facts.getent_passwd.jacques[1] }}:{{ ansible_facts.getent_passwd.jacques[2] }}"
    volumes:
      - /srv/jellyfin/config:/config
      - /srv/jellyfin/cache:/cache
      - /mnt/storage/media/Movies:/media/Movies
      - /mnt/storage/media/Shows:/media/Shows
    # Intel Quick Sync hardware transcoding
    devices:
      - /dev/dri/renderD128:/dev/dri/renderD128
    group_add:
      - "{{ ansible_facts.getent_group.render[1] }}"
    ports:
      - 8096:8096
    restart: unless-stopped
